# PayPal sandbox app (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Public URL of this deployment, e.g. https://your-app.onrender.com (used for the Log in with PayPal return URL)
PUBLIC_BASE_URL=http://localhost:3000
# Claude API key (console.anthropic.com). Used to read listings and to check the live proof frames.
ANTHROPIC_API_KEY=
# Optional: secret for signing the seller session cookie. Defaults to a key derived from PAYPAL_CLIENT_SECRET.
APP_SECRET=
# Postgres connection string (Neon free tier works). Stores the buyer links and their proof frames.
# Without it, buyer links live in memory and disappear when the server restarts.
DATABASE_URL=
# Optional: override the Claude models (default claude-opus-5-5)
# VERIFY_MODEL=claude-opus-5-5
# LISTING_MODEL=claude-opus-5-5

# Local development only
# PayPal does not accept a localhost return URL, so locally a fake seller session stands in for the login:
# DEV_FAKE_SELLER=1
# PayPal account id (payer_id) of your sandbox seller, so local orders use merchant_id as the payee:
# DEV_SELLER_PAYER_ID=
# Save each verified attempt (frames + result) to this folder, for the eval. Never in production.
# ATTEMPTS_DIR=../eval/attempts

# Optional: daily cap on Claude calls (listing reads + verifications), per UTC day. Default 200.
# MAX_CLAUDE_CALLS_PER_DAY=200
# Optional: thinking effort of the vision step: low (default), medium or high.
# VERIFY_EFFORT=low

# Optional eval capture on a deployed server, for your own test accounts only (the frames
# show the person doing the proof): comma-separated PayPal payer ids. Off when empty.
# EVAL_CAPTURE_SELLERS=
# Token for the export routes used by scripts/pull-attempts.ts (24+ random characters).
# EVAL_EXPORT_TOKEN=
